---
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';
import graphikRegularUrl from '../assets/fonts/Graphik-Regular.woff2?url';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const description =
  lang === 'ru'
    ? 'Product design portfolio'
    : 'Product design portfolio';
const previewImage = '/preview_portfolio.png';
const previewImageAlt =
  lang === 'ru'
    ? 'Превью портфолио Карины Литвиновой'
    : 'Preview of Karina Litvinova’s product design portfolio';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
    rel="preload"
    href={graphikRegularUrl}
    as="font"
    type="font/woff2"
    crossorigin="anonymous"
  />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Karina Litvinova" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1679" />
    <meta property="og:image:height" content="1166" />
    <meta property="og:image:alt" content={previewImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={previewImageAlt} />
    <ClientRouter />
  </head>
  <body>
    <slot />

    <script>
      import { playClickSound } from '../utils/sound';

      // Click-sound targets, deliberately narrow: the hero's own links, the
      // footer's social links, and the "Karina" name trigger. Everything
      // else (project cards, the table of contents, links inside article
      // copy) stays silent — the sound is an accent on a few deliberate
      // interactions, not general link feedback.
      const SOUND_TARGETS = '.hero a, .footer-links a, .name-trigger';

      // The language switch lives inside the hero, so its own links would
      // otherwise be caught by `.hero a`. It already plays the sound itself
      // from its `change` handler, and its `<a>` — though `pointer-events:
      // none` for real pointers — still receives the programmatic
      // `link.click()` the switch fires, which would double-trigger it.
      const EXCLUDED = '.switch-nav-link, .switch-noscript-link';

      function initLinkSounds() {
        document.querySelectorAll<HTMLElement>(SOUND_TARGETS).forEach((el) => {
          if (el.closest(EXCLUDED)) return;
          el.addEventListener('mouseenter', () => playClickSound());
          el.addEventListener('click', () => playClickSound());
        });
      }

      document.addEventListener('astro:page-load', initLinkSounds);

      document.addEventListener('astro:after-swap', () => {
        // Mark this render as router-swapped rather than freshly loaded, so
        // the `.appear` intro cascade sits out internal navigation (see
        // `.no-appear` in global.css). Runs before paint, so the skip
        // applies without the content ever flashing in mid-animation.
        // Re-applied on every swap because the swap copies the incoming
        // document's <html> attributes over this element's.
        document.documentElement.classList.add('no-appear');

        // Restore scroll position after a language switch (see
        // LanguageSwitch.astro, which stashes it before navigating). Also
        // before paint, so the user never sees the top-of-page flash.
        const savedY = sessionStorage.getItem('lang-switch-scroll-y');
        if (savedY === null) return;
        sessionStorage.removeItem('lang-switch-scroll-y');
        window.scrollTo({ top: Number(savedY), left: 0, behavior: 'instant' });
      });
    </script>
  </body>
</html>
