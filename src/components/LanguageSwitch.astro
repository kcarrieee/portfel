---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const tabOrder = Object.keys(languages) as Lang[];
const tabLabel: Record<Lang, string> = { en: 'eng', ru: 'ru' };
const otherLang = tabOrder.find((candidate) => candidate !== lang)!;
const isChecked = lang === tabOrder[1];

const switchAriaLabel: Record<Lang, string> = {
  en: 'Switch language to English',
  ru: 'Переключить язык на русский',
};
---

<div class="language-switch" data-lang-switch>
  <input
    type="checkbox"
    switch
    role="switch"
    checked={isChecked}
    aria-label={switchAriaLabel[otherLang]}
    class="switch-input"
    data-lang-switch-input
  />
  <div class="switch-visual" aria-hidden="true">
    <span class="switch-thumb"></span>
    {
      tabOrder.map((tabLang) => (
        <span class:list={['switch-label', { 'is-active': tabLang === lang }]}>
          {tabLabel[tabLang]}
        </span>
      ))
    }
  </div>
  <a
    class="switch-nav-link"
    href={altHref}
    hreflang={otherLang}
    tabindex="-1"
    aria-hidden="true"
    data-lang-switch-link
  >
    {tabLabel[otherLang]}
  </a>
  <noscript>
    <a class="switch-noscript-link" href={altHref} hreflang={otherLang}>
      {tabLabel[otherLang]}
    </a>
  </noscript>
</div>

<script>
  import { triggerHaptic } from '../utils/haptics';
  import { playClickSound } from '../utils/sound';

  function initLanguageSwitch() {
    document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((wrapper) => {
      const input = wrapper.querySelector<HTMLInputElement>('[data-lang-switch-input]');
      const link = wrapper.querySelector<HTMLAnchorElement>('[data-lang-switch-link]');
      if (!input || !link) return;
      input.addEventListener('change', () => {
        triggerHaptic();
        playClickSound();
        // The language switch swaps to a different URL (/ vs /ru/), which
        // the browser treats as a real navigation and scrolls to the top —
        // jarring here since it's the same content, just relabelled. Stash
        // the scroll position for `astro:after-swap` (see Layout.astro) to
        // restore before the new page paints.
        sessionStorage.setItem('lang-switch-scroll-y', String(window.scrollY));
        link.click();
      });
    });
  }

  document.addEventListener('astro:page-load', initLanguageSwitch);
</script>

<style>
  .language-switch {
    position: relative;
    display: inline-flex;
  }

  .switch-input {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    min-width: 32px;
    min-height: 32px;
    margin: 0;
    appearance: none;
    background: none;
    border: none;
    opacity: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .switch-nav-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    width: 1px;
    height: 1px;
    color: transparent;
    pointer-events: none;
  }

  .switch-visual {
    position: relative;
    display: flex;
    /* padding: 3px; */
    /* background: #111111;
    border: 1px solid #1d1d1d;
    border-radius: 10px;
    box-shadow: inset -3px 1px 7px -1px rgba(0, 0, 0, 0.25); */
    transition: transform 160ms ease;
  }

  /* Static divider between the two labels. It used to be the sliding thumb
     that tracked the active language, which is why a `:checked` rule moved
     it — that rule is gone, so it now stays put when the language changes. */
  .switch-thumb {
    position: absolute;
    top: 9px;
    left: 34px;
    width: 1px;
    height: calc(100% - 16px);
    background: rgba(57, 57, 57, 0.85);
  }

  .switch-input:active ~ .switch-visual {
    transform: scale(0.98);
  }

  .switch-input:focus-visible ~ .switch-visual {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .switch-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-size: 13px;
    line-height: 16px;
    color: #595959;
    transition: color 200ms ease;
  }

  .switch-label.is-active {
    color: #c3c3c3;
  }

  .switch-noscript-link {
    margin-left: 8px;
    color: var(--color-text-muted-5);
    font-size: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .switch-thumb,
    .switch-visual,
    .switch-label {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 549px) {
    .switch-visual {
    padding: 6px;
  }
  .switch-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-size: 14px;
    line-height: 16px;
    color: #474747;
    transition: color 200ms ease;
  }
  .switch-thumb {
    position: absolute;
    top: 12px;
    left: 40px;
    width: 1px;
    height: calc(100% - 24px);
    background: rgba(57, 57, 57, 0.85);
  }
  }
</style>
