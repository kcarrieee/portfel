---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const tabOrder = Object.keys(languages) as Lang[];
const tabLabel: Record<Lang, string> = { en: 'en', ru: 'ru' };
const otherLang = tabOrder.find((candidate) => candidate !== lang)!;
const isChecked = lang === tabOrder[1];

const switchAriaLabel: Record<Lang, string> = {
  en: 'Switch language to English',
  ru: 'Переключить язык на русский',
};
---

<div class="language-switch" data-lang-switch>
  <label class="switch-control">
    <input
      type="checkbox"
      switch
      role="switch"
      checked={isChecked}
      aria-label={switchAriaLabel[otherLang]}
      class="switch-input"
      data-lang-switch-input
    />
    <span class="switch-visual" aria-hidden="true">
      <i class="switch-thumb"></i>
      {
        tabOrder.map((tabLang) => (
          <span class="switch-label">{tabLabel[tabLang]}</span>
        ))
      }
    </span>
  </label>
  <a
    class="switch-nav-link"
    href={altHref}
    hreflang={otherLang}
    tabindex="-1"
    aria-hidden="true"
    data-lang-switch-link
  >
    {tabLabel[otherLang]}
  </a>
  <noscript>
    <a class="switch-noscript-link" href={altHref} hreflang={otherLang}>
      {tabLabel[otherLang]}
    </a>
  </noscript>
</div>

<script>
  import { triggerHaptic } from '../utils/haptics';
  import { playClickSound } from '../utils/sound';

  function initLanguageSwitch() {
    document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((wrapper) => {
      const input = wrapper.querySelector<HTMLInputElement>('[data-lang-switch-input]');
      const link = wrapper.querySelector<HTMLAnchorElement>('[data-lang-switch-link]');
      if (!input || !link) return;
      input.addEventListener('change', () => {
        if (wrapper.classList.contains('is-switching')) return;
        wrapper.classList.add('is-switching');
        input.blur();
        triggerHaptic();
        playClickSound();
        // The language switch swaps to a different URL (/ vs /ru/), which
        // the browser treats as a real navigation and scrolls to the top —
        // jarring here since it's the same content, just relabelled. Stash
        // the scroll position for `astro:after-swap` (see Layout.astro) to
        // restore before the new page paints.
        sessionStorage.setItem('lang-switch-scroll-y', String(window.scrollY));
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.setTimeout(() => link.click(), prefersReducedMotion ? 0 : 220);
      });
    });
  }

  document.addEventListener('astro:page-load', initLanguageSwitch);
</script>

<style>
  .language-switch {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
  }

  .switch-control {
    position: relative;
    display: inline-flex;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .switch-input {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    min-width: 30px;
    min-height: 30px;
    margin: 0;
    appearance: none;
    background: none;
    border: none;
    opacity: 0;
    pointer-events: none;
  }

  .language-switch.is-switching .switch-control {
    pointer-events: none;
  }

  .switch-nav-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    width: 1px;
    height: 1px;
    color: transparent;
    pointer-events: none;
  }

  .switch-visual {
    --switch-tab-width: 36px;
    /* Меняйте это значение, чтобы настроить padding активного языка. */
    --switch-active-padding-inline: 1px;
    /* Расстояние между активным и неактивным языком. */
    --switch-tab-gap: 0px;

    position: relative;
    display: grid;
    grid-template-columns: repeat(2, var(--switch-tab-width));
    column-gap: var(--switch-tab-gap);
    height: 30px;
    padding-inline: var(--switch-active-padding-inline);
    white-space: nowrap;
  }

  @media (max-width: 549px) {
    .switch-visual {
      --switch-tab-width: 40px;
      height: 36px;
      /* Меняйте это значение, чтобы настроить padding активного языка. */
      --switch-active-padding-inline: 2px;
      /* Расстояние между активным и неактивным языком. */
      --switch-tab-gap: 2px;
    }
  }

  .switch-thumb {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--switch-tab-width) + var(--switch-active-padding-inline) * 2);
    box-sizing: border-box;
    border-radius: 11px;
    background-color: transparent;
    transform: translateX(0);
    transition:
      transform 220ms cubic-bezier(0.4, 0, 0.2, 1),
      scale 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .switch-thumb::before,
  .switch-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .switch-thumb::before {
    background: linear-gradient(
      180deg,
      var(--color-switch-border-start) 0%,
      var(--color-switch-border-end) 100%
    );
  }

  .switch-thumb::after {
    background: linear-gradient(
      180deg,
      var(--color-switch-border-hover-start) 0%,
      var(--color-switch-border-hover-end) 100%
    );
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .switch-input:checked ~ .switch-visual .switch-thumb {
    transform: translateX(
      calc(var(--switch-tab-width) + var(--switch-tab-gap))
    );
  }

  .switch-input:not(:checked)
    ~ .switch-visual:has(.switch-label:first-of-type:hover)
    .switch-thumb::after,
  .switch-input:checked
    ~ .switch-visual:has(.switch-label:last-of-type:hover)
    .switch-thumb::after {
    opacity: 1;
  }

  .switch-control:active .switch-thumb {
    scale: 0.98;
  }

  .switch-input:focus-visible ~ .switch-visual {
    outline: 2px solid #7aff78;
    outline-offset: 2px;
  }

  .switch-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted-2);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.025em;
    transition: color 200ms ease;
  }

  .switch-label:hover {
    color: var(--color-switch-label-hover);
  }

  .switch-input:not(:checked) ~ .switch-visual .switch-label:first-of-type,
  .switch-input:checked ~ .switch-visual .switch-label:last-of-type {
    color: var(--color-text);
  }

  .switch-noscript-link {
    margin-left: 8px;
    color: var(--color-text-muted-5);
    font-size: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .switch-thumb,
    .switch-thumb::after,
    .switch-visual,
    .switch-label {
      transition-duration: 0.01ms;
    }
  }
</style>
