---
import Layout from '../../layouts/Layout.astro';
import LanguageSwitch from '../LanguageSwitch.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import type { MarkdownHeading } from 'astro';

interface Props {
  lang: Lang;
  altHref: string;
  title: string;
  backHref: string;
  backLabel: string;
  cover?: string;
  coverAlt?: string;
  headings?: MarkdownHeading[];
}

const {
  lang,
  altHref,
  title,
  backHref,
  backLabel,
  cover,
  coverAlt = '',
  headings = [],
} = Astro.props;

const t = useTranslations(lang);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
---

<Layout lang={lang} title={title}>
  {
    tocHeadings.length > 0 && (
      <aside class="toc appear" style="--appear-delay: 0ms">
        <a class="toc-back" href={backHref}>
          <img class="toc-back-arrow" src="/icons/icon-arrow.svg" alt="" width="16" height="16" />
          {t('toc.index')}
        </a>
        <nav class="toc-list">
          {tocHeadings.map((heading) => (
            <a class="toc-link" href={`#${heading.slug}`} data-toc-link={heading.slug}>
              {heading.text}
            </a>
          ))}
        </nav>
      </aside>
    )
  }
  <div class="page">
    <nav class="nav appear" style="--appear-delay: 0ms">

      <a class="back" href={backHref}>
        <img class="back-arrow" src="/icons/icon-arrow.svg" alt="" width="16" height="16" />
        {backLabel}
      </a>
      <LanguageSwitch lang={lang} altHref={altHref} />
    </nav>
    {
      cover && (
        <div class="cover appear" style="--appear-delay: 40ms">
          <img src={cover} alt={coverAlt} />
        </div>
      )
    }
    <slot name="header" />
    <div class="content">
      <slot />
    </div>
  </div>
</Layout>

<script>
  // Load-in cascade (see `.appear` in global.css). `.toc`, `.nav`, `.cover`,
  // and the header are tagged with a fixed `--appear-delay` directly in the
  // markup; the article body is arbitrary rendered markdown, so its direct
  // children (h2, p, ul, img, video, ...) are tagged here instead, each a
  // little later than the last. The delay growth is capped so a very long
  // article doesn't push the tail elements out several seconds.
  //
  // Whether the cascade actually animates is decided in CSS by the
  // `.no-appear` class Layout.astro sets on router-swapped renders, so
  // there's nothing to check here — tagging is unconditional.
  function initAppearCascade() {
    const content = document.querySelector<HTMLElement>('.content');
    if (!content) return;

    Array.from(content.children).forEach((el, index) => {
      const item = el as HTMLElement;
      item.classList.add('appear');
      item.style.setProperty('--appear-delay', `${Math.min(140 + index * 15, 500)}ms`);
    });
  }

  document.addEventListener('astro:page-load', initAppearCascade);

  function initToc() {
    const headingEls = document.querySelectorAll<HTMLElement>('.content h2[id]');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (headingEls.length === 0 || tocLinks.length === 0) return;

    const setActive = (id: string) => {
      tocLinks.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.tocLink === id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        }
      },
      { rootMargin: '0px 0px -80% 0px', threshold: 0 },
    );

    headingEls.forEach((heading) => observer.observe(heading));
    setActive(headingEls[0].id);
  }

  function initContentVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('.content video[data-lazy-video]');
    if (videos.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.5 },
    );

    videos.forEach((video) => observer.observe(video));
  }

  document.addEventListener('astro:page-load', initToc);
  document.addEventListener('astro:page-load', initContentVideos);
</script>

<style>
  .toc {
    display: none;
  }

  @media (min-width: 1280px) {
    .toc {
      display: flex;
      flex-direction: column;
      gap: 24px;
      position: fixed;
      top: 90px;
      left: 40px;
      width: 200px;
    }
  }

  .toc-back {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-muted-2);
    text-decoration: none;
    font-size: 14px;
  }

  .toc-back-arrow {
    transform: rotate(-90deg);
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .toc-link {
    color: var(--color-text-muted-2);
    text-decoration: none;
    font-size: 14px;
    line-height: 1.4;
  }

  .toc-link.is-active {
    color: var(--color-text);
  }

  .page {
    max-width: 600px;
    width: 100%;
    margin-inline: auto;
    padding: 90px 24px 60px;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  /* On desktop the back link is hidden (below) and the language switch
     moves into the title row instead, next to the project date — see
     `.header-lang-switch` in the project page templates. */
  @media (min-width: 1280px) {
    .nav {
      display: none;
    }
  }

  .back {
    display: none;
    align-items: center;
    gap: 8px;
    color: var(--color-text-muted-2);
    text-decoration: none;
    font-size: 16px;
  }

  @media (max-width: 1279px) {
    .back {
      display: flex;
    }
  }

  .back-arrow {
    transform: rotate(-90deg);
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 670 / 340;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-card-bg);
    margin-bottom: 32px;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content :global(h2) {
    font-size: 14px;
    font-weight: normal;
    color: var(--color-block-heading);
    letter-spacing: 0.02em;
    margin: 32px 0 8px;
    margin-top:100px;
  }
  


  .content :global(h2:first-child) {
    margin-top:100px;
  }

  .content :global(p) {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-block-text);
    margin: 0 0 16px;
  }

  .content :global(ul),
  .content :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 0 16px;
    padding-left: 20px;
  }

  .content :global(li) {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-block-text);
  }
  .content :global(a) {
    color: #fff;
    position: relative;
    display: inline;
    font-size: 14px;
    font-weight: 400;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid #666667; /* soft grey */
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .content :global(a)::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0px;
  width: 100%;
  height: 0.5px;
  background: #ffffff;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);   
}
.content :global(a):hover {
  border-color: transparent;
}
.content :global(a):hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

  

.content :global(li)::marker {
    color: var(--color-text);
}

.content :global(img) {
    width: 100%;
    height: fit-content;
    border-radius: 8px;
    margin-block: 20px;
}

.content :global(video) {
    width: 100%;
    height: fit-content;
    border-radius: 8px;
    margin-block: 20px;
}

  @media (max-width: 994px) {
    .page {
      max-width: 100vw;
      width: 100vw;
      padding-inline: 20px;
      padding-top: 60px;
    }
   
  }
</style>
