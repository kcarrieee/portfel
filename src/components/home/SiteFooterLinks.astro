---
import { links, homeContent, type Lang } from '../../data/home';

interface Props {
  lang: Lang;
  delay?: number;
}

const { lang, delay = 0 } = Astro.props;
const footer = homeContent[lang].footer;
---

<div class="footer-links appear" id="contact" style={`--appear-delay: ${delay}ms`}>
  <a href={links.email}>{footer.email}</a>
  <a href={links.xacc} target="_blank" rel="noopener noreferrer">{footer.xacc}</a>
  <a href={links.linkedin} target="_blank" rel="noopener noreferrer">{footer.linkedin}</a>
  <a href={links.telegram} target="_blank" rel="noopener noreferrer">{footer.telegram}</a>
  <a href={links.behance} target="_blank" rel="noopener noreferrer">{footer.behance}</a>
</div>

<style>
  .footer-links {
    display: flex;
    gap: 24px;
    align-items: center;
    width: 100%;
    font-size: 15px;
    color: var(--color-text-muted-2);
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: #dddddd;
  }
  
  @media (max-width: 549px) {
    .footer-links {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    flex-direction: column;
  }
  }
</style>
