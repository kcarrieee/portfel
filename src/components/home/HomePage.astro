---
import { getCollection } from 'astro:content';
import ProfileSidebar from './ProfileSidebar.astro';
import ProjectsList from './ProjectsList.astro';
import LeadershipList from './LeadershipList.astro';
import SiteFooterLinks from './SiteFooterLinks.astro';
import { homeContent, type Lang } from '../../data/home';

interface Props {
  lang: Lang;
  altHref: string;
}

  

const { lang, altHref } = Astro.props;
const content = homeContent[lang];
const basePath = lang === 'en' ? '/projects' : '/ru/projects';
const leadershipBasePath = lang === 'en' ? '/leadership' : '/ru/leadership';

const projects = (await getCollection('projects', (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);

const externalLeadershipItem = {
  title: 'Design Inspo Gallery',
  year: 'Curated',
  href: 'https://pin.it/68Uvps3FB',
  external: true,
  order: 2,
};

const leadershipItems = [
  ...(await getCollection('leadership', (entry) => entry.id.startsWith(`${lang}/`))).map((entry) => ({
    title: entry.data.title,
    year: entry.data.year ?? '',
    href: `${leadershipBasePath}/${entry.id.split('/')[1]}`,
    external: false,
    order: entry.data.order,
  })),
  externalLeadershipItem,
]
  .sort((a, b) => a.order - b.order)
  .map(({ order, ...item }) => item);

// Continues the hero's cascade (0-160ms) — one project card at a time,
// then the leadership block, then the footer, matching shedsgns.me's
// load-in pacing.
const projectsListDelay = 230;
const leadershipDelay = projectsListDelay + projects.length * 12 + 40;
const footerDelay = leadershipDelay + 40;
const timeDelay = footerDelay + 20;
---

<div class="page">
  <div class="content">
    <ProfileSidebar lang={lang} altHref={altHref} />
    <div class="work">
      <div class="wrapper">
        <ProjectsList projects={projects} basePath={basePath} lang={lang} />
      </div>
      <LeadershipList heading={content.leadershipHeading} items={leadershipItems} delay={leadershipDelay} />
      <div class="foot_warpper">
      <SiteFooterLinks lang={lang} delay={footerDelay} />
      <p
        class="timeme_warpper appear"
        style={`--appear-delay: ${timeDelay}ms`}
        data-local-time
        data-timezone="Europe/Istanbul"
        data-locale={lang === 'en' ? 'en-US' : 'ru-RU'}
      >
        {content.localTimePrefix} <span data-local-time-value>&mdash;:&mdash;</span> {content.localTimeSuffix}
      </p>
    </div>
    </div>
  </div>
</div>

<style>
  .page {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 72px;
    align-items: flex-start;
    max-width: 600px;
    width: 100%;
    padding: 90px 24px 60px;
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: 70px;
    width: 100%;
    min-width: 0;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    margin-top: 36px;
    width: 100%;
  }
  .foot_warpper {
    display: flex;
    flex-direction: column;
    gap:8px;
  }
  .foot_warpper p{
    color:#777777;
  }

  .timeme_warpper [data-local-time-value] {
    display: inline-block;
    animation: time-pulse 1.9s ease-in-out infinite;
  }

  @keyframes time-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeme_warpper [data-local-time-value] {
      animation: none;
    }
  }

  @media (max-width: 549px) {
    .content {
      width: 100vw;
      max-width: 100vw;
      gap: 48px;
      padding-inline: 20px;
      padding-top: 60px;
    }
  }
</style>

<script>
  // Shows the live time in the timezone set via `data-timezone` (module
  // scope persists across Astro's client-side navigations, so the previous
  // interval is cleared each time rather than left running against a
  // detached element).
  let clockIntervalId: ReturnType<typeof setInterval> | undefined;

  function updateLocalTime() {
    document.querySelectorAll<HTMLElement>('[data-local-time]').forEach((el) => {
      const timeZone = el.dataset.timezone;
      const locale = el.dataset.locale ?? 'en-US';
      const valueEl = el.querySelector<HTMLElement>('[data-local-time-value]');
      if (!timeZone || !valueEl) return;

      const formatted = new Date().toLocaleTimeString(locale, {
        timeZone,
        hour: 'numeric',
        minute: '2-digit',
        hour12: locale.startsWith('en'),
      });
      valueEl.textContent = formatted.toLowerCase();
    });
  }

  function initLocalTime() {
    if (clockIntervalId !== undefined) clearInterval(clockIntervalId);
    if (!document.querySelector('[data-local-time]')) return;

    updateLocalTime();
    clockIntervalId = setInterval(updateLocalTime, 30_000);
  }

  document.addEventListener('astro:page-load', initLocalTime);
</script>
