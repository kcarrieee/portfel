---
interface Props {
  href: string;
  title: string;
  year: string;
  delay?: number;
  nda?: boolean;
  ndaTooltip?: string;
}

const { href, title, year, delay = 0, nda = false, ndaTooltip } = Astro.props;

// An NDA card still shows its cover and title, but renders as a plain
// container instead of a link — no href at all, so there's nothing to
// click through to and no pointer cursor implying otherwise.
const Tag = nda ? 'div' : 'a';
---


<Tag
  class:list={['project-card', 'appear', { 'is-nda': nda }]}
  href={nda ? undefined : href}
  style={`--appear-delay: ${delay}ms`}
>
  <div class="visual">
    <div class="cover-layer">
      <slot />
    </div>
    {
      nda && ndaTooltip && (
        <span class="nda-tooltip-layer" aria-hidden="true">
          <span class="nda-tooltip">{ndaTooltip}</span>
        </span>
      )
    }
  </div>
  <div class="meta">
    <div class="meta-main">
      <p class="title">{title}</p>
      {nda && <p class="nda">Under NDA</p>}
    </div>
    <p class="year">{year}</p>
  </div>
</Tag>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 570px;
    max-width: 100%;
    text-decoration: none;
    color: inherit;
    gap: 16px;
  }

  .visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    border: 1px solid #2f2f2f;
    overflow: hidden;
    background: var(--color-card-bg);
  }

  /* A conic-gradient sheen rotating behind a 1px ring mask — reads as
     light sweeping around the card edge, "liquid glass" style. Registering
     --shimmer-angle as an <angle> is what lets the browser interpolate it
     smoothly frame to frame instead of just snapping between values. */
  @property --shimmer-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  /* Lives on `.project-card`, not `.visual` — `overflow: hidden` on
     `.visual` (needed to clip the cover image/video) clips at the padding
     edge, so any ring drawn *on* `.visual` either sits under the image
     (inset: 0, same box the media fills) or gets clipped away trying to
     reach the border (inset: -1px, past the padding edge = clipped).
     Sitting on the unclipped parent and matching `.visual`'s box via the
     same width + aspect-ratio sidesteps both problems. */
  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    aspect-ratio: 1 / 1;
    z-index: 1;
    border-radius: 10px;
    padding: 1px;
    background: conic-gradient(
      from var(--shimmer-angle),
      transparent 0deg,
      transparent 55deg,
      rgba(255, 255, 255, 0.75) 90deg,
      rgba(200, 220, 255, 0.3) 118deg,
      transparent 155deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms ease;
    animation: shimmer-spin 3.2s linear infinite;
    animation-play-state: paused;
  }

  .project-card:hover::before,
  .project-card:focus-visible::before {
    opacity: 1;
    animation-play-state: running;
  }

  @keyframes shimmer-spin {
    to {
      --shimmer-angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card::before {
      transition-duration: 0.01ms;
      animation: none;
    }
  }

  /* Wraps the cover so the blur can be applied to one element we own,
     rather than reaching into whichever visual component filled the slot.
     `position: absolute; inset: 0` because `filter` makes this a
     containing block — the slotted media positions itself against this
     layer, so it has to match `.visual`'s box exactly. */
  .cover-layer {
    position: absolute;
    inset: 0;
    filter: none;
    transition:
      filter 300ms ease,
      transform 300ms ease;
  }

  /* Blur samples transparent pixels past the layer's edge, which would
     fade the card's border into the background. The slight scale pushes
     those edges out of sight behind `.visual`'s `overflow: hidden`. */
  .project-card.is-nda:hover .cover-layer {
    filter: blur(6px);
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-layer {
      transition-duration: 0.01ms;
    }
  }

  /* Centring layer, so the tooltip itself is free to use `transform` for
     its entrance without having to fold a `translate(-50%, -50%)` into
     every keyframe of the animation. */
  .nda-tooltip-layer {
    position: absolute;
    inset: 0;
    /* Above the shimmer ring (z-index: 1) drawn over the cover. */
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    pointer-events: none;
  }

  .nda-tooltip {
    max-width: 320px;
    padding: 10px 16px;
    border-radius: 12px;
    background: rgba(17, 17, 17, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    color: #e8e8e8;
    font-size: 14px;
    line-height: 20px;
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    transform: translateY(6px) scale(0.98);
    transition:
      opacity 240ms ease,
      transform 240ms ease;
  }

  .project-card:hover .nda-tooltip {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nda-tooltip {
      transition-duration: 0.01ms;
    }
  }

  .meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    font-size: 14px;
  }

  .meta-main {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .title {
    margin: 0;
    color: var(--color-text);
  }

  .nda {
    margin: 0;
    color: #e5484d;
    white-space: nowrap;
  }

  .year {
    margin: 0;
    color: var(--color-text-muted-3);
    white-space: nowrap;
  }
</style>
