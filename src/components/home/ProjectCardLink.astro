---
interface Props {
  href: string;
  title: string;
  year: string;
}

const { href, title, year } = Astro.props;
---


<a class="project-card" href={href} data-reveal>
  <div class="visual">
    <slot />
  </div>
  <div class="meta">
    <p class="title">{title}</p>
    <p class="year">{year}</p>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    width: 570px;
    max-width: 100%;
    text-decoration: none;
    color: inherit;
    gap: 16px;
  }

  .visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    border: 1px solid #2f2f2f;
    overflow: hidden;
    background: var(--color-card-bg);
  }

  .meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    font-size: 14px;
  }

  .title {
    margin: 0;
    color: var(--color-text);
  }

  .year {
    margin: 0;
    color: var(--color-text-muted-3);
    white-space: nowrap;
  }
</style>
