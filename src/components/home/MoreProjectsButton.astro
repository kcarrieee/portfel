---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<a class="more-projects" href="#contact">
  <div class="text">
    <p class="title">{title}</p>
    <p class="subtitle">{subtitle}</p>
  </div>
  <img class="arrow" src="/icons/icon-arrow.svg" alt="" width="24" height="24" />
</a>

<style>
  .more-projects {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 54px;
    text-decoration: none;
    color: inherit;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .title {
    margin: 0;
    font-size: 14px;
    color: var(--color-text);
  }

  .subtitle {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-muted-3);
  }

  .arrow {
    transform: rotate(90deg);
    flex-shrink: 0;
  }
</style>
