---
interface Props {
  heading: string;
  items: { title: string; year: string; href: string }[];
}

const { heading, items } = Astro.props;
---

<div class="leadership" data-reveal>
  <p class="heading">{heading}</p>
  {
    items.map((item) => (
      <a class="item" href={item.href}>
        <div class="text">
          <p class="year">{item.year}</p>
          <p class="title">{item.title}</p>
        </div>
      </a>
    ))
  }
</div>

<style>
  .leadership {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    width: 100%;
  }

  .heading {
    margin: 0;
    font-size: 16px;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }


  .text {
    display: flex;
    flex-direction: row;
    gap: 32px;
    font-size: 14px;
  }

  .title {
    margin: 0;
    color: var(--color-text);
  }

  .year {
    margin: 0;
    color: var(--color-text-muted-4);
  }
</style>
