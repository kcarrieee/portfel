---
import { getCollection, render } from 'astro:content';
import DetailLayout from '../../components/detail/DetailLayout.astro';
import LanguageSwitch from '../../components/LanguageSwitch.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (entry) => entry.id.startsWith('en/'));
  return projects.map((project) => ({
    params: { slug: project.id.split('/')[1] },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const lang = 'en';
const t = useTranslations(lang);
const slug = project.id.split('/')[1];
const altHref = `/ru/projects/${slug}`;
const hasMeta = project.data.duration || project.data.platform || project.data.role;
---

<DetailLayout
  lang={lang}
  altHref={altHref}
  title={project.data.title}
  backHref="/"
  backLabel={t('project.back')}
  cover={project.data.cover}
  coverAlt={project.data.title}
  headings={headings}
>
  <header class="header appear" style="--appear-delay: 80ms" slot="header">
    <div class="title-row">
      <div class="title-group">
        <h1 class="title">{project.data.title}</h1>
        {project.data.year && <p class="year year-inline">{project.data.year}</p>}
      </div>
      <div class="title-row-right">
        {project.data.year && <p class="year year-standalone">{project.data.year}</p>}
        <div class="header-lang-switch">
          <LanguageSwitch lang={lang} altHref={altHref} />
        </div>
      </div>
    </div>
    {
      hasMeta && (
        <div class="meta-row">
          {project.data.duration && (
            <p class="field">
              <span class="label">{t('project.duration')}:</span>{' '}
              <span class="value">{project.data.duration}</span>
            </p>
          )}
          {project.data.platform && (
            <p class="field">
              <span class="label">{t('project.platform')}:</span>{' '}
              <span class="value">{project.data.platform}</span>
            </p>
          )}
          {project.data.role && (
            <p class="field">
              <span class="label">{t('project.role')}:</span>{' '}
              <span class="value">{project.data.role}</span>
            </p>
          )}
        </div>
      )
    }
  </header>
  <Content />
</DetailLayout>

<style>
  .header {
    margin-bottom: 1px;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .title-group {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .title-row-right {
    display: flex;
    align-items: center;
  }

  .title {
    margin: 0;
    color: var(--color-text);
    font-size: 15px;
    font-weight: normal;
  }

  .year {
    margin: 0;
    color: var(--color-text-muted-3);
    font-size: 14px;
    white-space: nowrap;
  }

  .year-inline {
    display: none;
  }

  .header-lang-switch {
    display: none;
  }

  /* Desktop: the language switch moves from the top nav (hidden there,
     see DetailLayout) into the title row where the date used to sit, and
     the date moves next to the title in small text instead. */
  @media (min-width: 1280px) {
    .title-row {
      align-items: center;
    }

    .year-inline {
      display: inline;
    }

    .year-standalone {
      display: none;
    }

    .header-lang-switch {
      display: inline-flex;
    }
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  .field {
    display: flex;
    gap: 4px;
    margin: 0;
    font-size: 14px;
  }

  .label {
    color: var(--color-text-muted-4);
  }

  .value {
    color: var(--color-text-muted-2);
  }
</style>
